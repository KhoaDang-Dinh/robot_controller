# Rendered with envsubst by the destroy/recreate/resume test in infra_robot_sim
# (.github/workflows/recovery-test.yml), which checks out this repository at a
# pinned ref. Required: JOB_ID RUNTIME_GENERATION FENCING_TOKEN IMAGE_DIGEST GIT_REVISION.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: resume-smoke
  namespace: robot-platform
---
apiVersion: batch/v1
kind: Job
metadata:
  name: resume-smoke-${RUNTIME_GENERATION}
  namespace: robot-platform
  labels:
    app.kubernetes.io/name: resume-smoke
    app.kubernetes.io/part-of: robot-sim
    robot-sim/job-id: "${JOB_ID}"
    robot-sim/experiment: recovery-test
    robot-sim/cost-center: thesis
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: resume-smoke
        app.kubernetes.io/part-of: robot-sim
        robot-sim/job-id: "${JOB_ID}"
        robot-sim/experiment: recovery-test
        robot-sim/cost-center: thesis
    spec:
      restartPolicy: Never
      serviceAccountName: resume-smoke
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
        - name: ghcr-pull
      terminationGracePeriodSeconds: 90
      containers:
        - name: smoke
          image: "ghcr.io/khoadang-dinh/resume-smoke@${IMAGE_DIGEST}"
          imagePullPolicy: IfNotPresent
          env:
            - name: AWS_REGION
              value: "ap-southeast-1"
            - name: PLATFORM_PROJECT
              value: "robot-sim"
            - name: PLATFORM_ENVIRONMENT
              value: "dev"
            - name: JOB_ID
              value: "${JOB_ID}"
            - name: FENCING_TOKEN
              value: "${FENCING_TOKEN}"
            - name: IMAGE_DIGEST
              value: "${IMAGE_DIGEST}"
            - name: GIT_REVISION
              value: "${GIT_REVISION}"
            - name: CHECKPOINT_INTERVAL_SECONDS
              value: "5"
            - name: EXPERIMENT
              value: recovery-test
            - name: COST_CENTER
              value: thesis
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            capabilities:
              drop: ["ALL"]
