{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "generateName": "robot-hello-"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 120,
    "ttlSecondsAfterFinished": 600,
    "template": {
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "hello",
            "image": "busybox:1.37.0",
            "command": [
              "sh",
              "-c",
              "printf '%s\\n' HELLO_ROBOT_K8S"
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
