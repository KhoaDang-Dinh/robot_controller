# Build context: repository root.
#   docker build -f containers/Dockerfile.robot-controller -t ghcr.io/khoadang-dinh/robot-controller:dev .
# Base image tag is tracked by Dependabot; release builds record the resulting
# image digest, and only that digest is deployed.
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/KhoaDang-Dinh/robot_controller" \
      org.opencontainers.image.title="robot-controller" \
      org.opencontainers.image.description="Supervisory runtime controller" \
      org.opencontainers.image.licenses="NOASSERTION"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OTEL_SERVICE_NAME=robot-controller \
    IMAGE_NAME=ghcr.io/khoadang-dinh/robot-controller

COPY workloads/requirements.txt /tmp/requirements.txt
RUN groupadd --gid 10001 workload \
    && useradd --create-home --uid 10001 --gid 10001 workload \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

WORKDIR /app
COPY workloads/telemetry.py /app/telemetry.py
COPY workloads/controller.py /app/controller.py

USER 10001:10001
HEALTHCHECK NONE
ENTRYPOINT ["python", "/app/controller.py"]

