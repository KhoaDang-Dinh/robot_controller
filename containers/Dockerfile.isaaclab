# Training image: Isaac Sim 5.1.0 + Isaac Lab v2.3.2 (rsl_rl) + robot_controller.
#
#   docker build -f containers/Dockerfile.isaaclab -t ghcr.io/khoadang-dinh/robot-sim-isaaclab:dev .
#
# Pins move together: Isaac Lab v2.3.2 is built on Isaac Sim 5.1.0 (Python 3.11).
# Check NVIDIA's compatibility notes before changing either. The NVIDIA Omniverse
# EULA must be accepted at run time (ACCEPT_EULA=Y); the Helm chart only sets it
# when isaacsim.acceptEula=true. Privacy/data-collection consent is NOT set.
ARG ISAACSIM_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0
FROM ${ISAACSIM_IMAGE}

ARG ISAACLAB_REF=v2.3.2
ARG ISAACLAB_COMMIT=37ddf626871758333d6ed89cf64ad702aef127d0
ARG UV_VERSION=0.12.21
ENV ISAACSIM_PATH=/isaac-sim \
    ISAACLAB_PATH=/opt/isaaclab \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME=robot-sim-isaaclab \
    IMAGE_NAME=ghcr.io/khoadang-dinh/robot-sim-isaaclab

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential cmake libglib2.0-0 ncurses-term \
    && rm -rf /var/lib/apt/lists/*

# Isaac Lab at an exact commit (a moved tag fails the build).
RUN git clone --depth 1 --branch "${ISAACLAB_REF}" https://github.com/isaac-sim/IsaacLab.git "${ISAACLAB_PATH}" \
    && test "$(git -C "${ISAACLAB_PATH}" rev-parse HEAD)" = "${ISAACLAB_COMMIT}" \
    && ln -s "${ISAACSIM_PATH}" "${ISAACLAB_PATH}/_isaac_sim"
# Same steps as Isaac Lab's docker/Dockerfile.base: extension apt deps, then the
# Isaac Lab packages with the rsl_rl extra only (no other RL frameworks).
# (install_deps.py runs apt-get update itself)
RUN "${ISAACLAB_PATH}/isaaclab.sh" -p -m pip install toml \
    && "${ISAACLAB_PATH}/isaaclab.sh" -p "${ISAACLAB_PATH}/tools/install_deps.py" apt "${ISAACLAB_PATH}/source" \
    && rm -rf /var/lib/apt/lists/* \
    && "${ISAACLAB_PATH}/isaaclab.sh" --install rsl_rl

# robot_controller into Isaac Sim's Python, constrained to the versions in uv.lock.
COPY pyproject.toml uv.lock README.md /opt/robot_controller/
COPY src /opt/robot_controller/src
WORKDIR /opt/robot_controller
RUN "${ISAACSIM_PATH}/python.sh" -m pip install "uv==${UV_VERSION}" \
    && "${ISAACSIM_PATH}/python.sh" -m uv export --frozen --no-dev --no-emit-project --no-hashes -o /tmp/constraints.txt \
    && "${ISAACSIM_PATH}/python.sh" -m pip install --constraint /tmp/constraints.txt /opt/robot_controller \
    && rm /tmp/constraints.txt
COPY experiments /app/experiments

LABEL org.opencontainers.image.source="https://github.com/KhoaDang-Dinh/robot_controller" \
      org.opencontainers.image.title="robot-sim-isaaclab" \
      org.opencontainers.image.description="robot_controller runner on Isaac Lab v2.3.2 / Isaac Sim 5.1.0" \
      org.opencontainers.image.licenses="NOASSERTION"

# Isaac Sim's rootless user; caches live under /isaac-sim/.cache etc. (mounted by the chart).
USER 1234:1234
WORKDIR /tmp
HEALTHCHECK NONE
ENTRYPOINT ["/isaac-sim/python.sh", "-m", "robot_controller.cli"]
CMD ["run"]
